{
  "name": "donna",
  "displayName": "Donna — Pre-PR Impact Assessment",
  "description": "Runs in parallel to your coding agent and assesses the system-wide impact of its change before you open a pull request: affected services, design conformance, backward compatibility, production risk, required tests, and reviewers.",
  "version": "0.1.0",
  "publisher": "anshitaarya",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Linters",
    "AI",
    "SCM Providers"
  ],
  "keywords": [
    "impact analysis",
    "architecture",
    "code review",
    "coding agent",
    "dependency graph",
    "adr"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "donna",
          "title": "Donna",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "donna": [
        {
          "id": "donna.assessment",
          "name": "Impact Assessment",
          "contextualTitle": "Impact assessment for the current change"
        },
        {
          "id": "donna.checklist",
          "name": "Before PR",
          "contextualTitle": "What to resolve before opening a PR"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "donna.assessment",
        "contents": "No assessment yet.\n\nDonna watches for changes your coding agent makes and assesses their system-wide impact before you open a PR.\n\n[Assess Current Change](command:donna.assess)\n[Open Scorecard](command:donna.openScorecard)\n[Configure Analysis Context](command:donna.configureContext)\n[Load Synthetic Demo Context](command:donna.loadDemoContext)\n[Connect Integrations](command:donna.connectIntegrations)\n\nContext settings are stored by VS Code for this workspace. Donna reads repository context files without creating Donna-specific files in the repository."
      }
    ],
    "commands": [
      {
        "command": "donna.assess",
        "title": "Donna: Assess Current Change",
        "icon": "$(search)"
      },
      {
        "command": "donna.assessWithModel",
        "title": "Donna: Assess With Model Pass",
        "icon": "$(sparkle)"
      },
      {
        "command": "donna.connectIntegrations",
        "title": "Donna: Connect Integrations",
        "icon": "$(plug)"
      },
      {
        "command": "donna.openScorecard",
        "title": "Donna: Open Scorecard",
        "icon": "$(graph)"
      },
      {
        "command": "donna.requestDesignReview",
        "title": "Donna: Send to Design-Review Agent",
        "icon": "$(git-pull-request-draft)"
      },
      {
        "command": "donna.toggleWatch",
        "title": "Donna: Toggle Watch Mode",
        "icon": "$(eye)"
      },
      {
        "command": "donna.refresh",
        "title": "Donna: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "donna.openFinding",
        "title": "Donna: Go to Finding",
        "icon": "$(go-to-file)"
      },
      {
        "command": "donna.copyAssessment",
        "title": "Donna: Copy Assessment as Markdown",
        "icon": "$(clippy)"
      },
      {
        "command": "donna.acceptFinding",
        "title": "Donna: Accept This Finding",
        "icon": "$(check)"
      },
      {
        "command": "donna.overrideInferredFinding",
        "title": "Donna: Override Inferred Finding",
        "icon": "$(edit)"
      },
      {
        "command": "donna.configureContext",
        "title": "Donna: Configure Analysis Context",
        "icon": "$(settings-gear)"
      },
      {
        "command": "donna.saveContext",
        "title": "Donna: Save Context Settings",
        "icon": "$(save)"
      },
      {
        "command": "donna.importContextFile",
        "title": "Donna: Import Context File",
        "icon": "$(archive)"
      },
      {
        "command": "donna.loadDemoContext",
        "title": "Donna: Load Synthetic Demo Context",
        "icon": "$(beaker)"
      },
      {
        "command": "donna.resetContext",
        "title": "Donna: Reset Workspace Context",
        "icon": "$(clear-all)"
      },
      {
        "command": "donna.setApiKey",
        "title": "Donna: Set Anthropic API Key",
        "icon": "$(key)"
      },
      {
        "command": "donna.clearApiKey",
        "title": "Donna: Clear Anthropic API Key"
      },
      {
        "command": "donna.showLog",
        "title": "Donna: Show Log",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "donna.assess",
          "when": "view == donna.assessment",
          "group": "navigation@1"
        },
        {
          "command": "donna.assessWithModel",
          "when": "view == donna.assessment",
          "group": "navigation@2"
        },
        {
          "command": "donna.openScorecard",
          "when": "view == donna.assessment",
          "group": "navigation@3"
        },
        {
          "command": "donna.requestDesignReview",
          "when": "view == donna.assessment",
          "group": "1_actions@1"
        },
        {
          "command": "donna.copyAssessment",
          "when": "view == donna.assessment",
          "group": "1_actions@2"
        },
        {
          "command": "donna.toggleWatch",
          "when": "view == donna.assessment",
          "group": "2_config@1"
        },
        {
          "command": "donna.refresh",
          "when": "view == donna.checklist",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "donna.openFinding",
          "when": "viewItem =~ /locatable/",
          "group": "inline@1"
        },
        {
          "command": "donna.acceptFinding",
          "when": "viewItem =~ /observation/ && viewItem !~ /inferred/",
          "group": "9_accept@1"
        },
        {
          "command": "donna.overrideInferredFinding",
          "when": "viewItem =~ /inferred/",
          "group": "9_accept@1"
        }
      ],
      "commandPalette": [
        {
          "command": "donna.openFinding",
          "when": "false"
        },
        {
          "command": "donna.acceptFinding",
          "when": "false"
        }
        ,
        {
          "command": "donna.overrideInferredFinding",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Donna",
      "properties": {
        "donna.baseRef": {
          "type": "string",
          "default": "",
          "markdownDescription": "Git ref to compare against. Empty means the merge base with the default branch (`origin/main`, `main`, `origin/master`, `master`, in that order) — which is what you want, because comparing with the branch tip would attribute other people's commits to your change."
        },
        "donna.watch.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Re-assess automatically when files change. This is what makes Donna run *in parallel* to a coding agent: it reacts to the agent's edits without you asking."
        },
        "donna.watch.debounceMs": {
          "type": "number",
          "default": 2500,
          "minimum": 500,
          "markdownDescription": "Quiet period after the last file change before re-assessing. Coding agents write files in bursts; this waits for the burst to finish rather than assessing a half-written change."
        },
        "donna.blastRadiusDepth": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 6,
          "markdownDescription": "How many import hops to follow when working out who depends on the changed modules. Beyond about 3 the answer in a large repo is \"most of the codebase\", which is true but not actionable — the scorecard reports when the traversal was cut short."
        },
        "donna.llm.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Allow model review of active ADR prose and design intent. ADR interpretations are inferred and cited; fixed code checks always run regardless."
        },
        "donna.llm.trigger": {
          "type": "string",
          "enum": [
            "manual",
            "onConflict",
            "everyAssessment"
          ],
          "default": "onConflict",
          "markdownEnumDescriptions": [
            "Only when you run `Donna: Assess With Model Pass`.",
            "Automatically when fixed checks find a conflict or an unchecked result, and when active ADRs are available for inferred review. Recommended.",
            "On every settled change. Highest coverage, highest token spend."
          ],
          "description": "When to invoke the model."
        },
        "donna.llm.provider": {
          "type": "string",
          "enum": [
            "vscode",
            "anthropic"
          ],
          "default": "vscode",
          "markdownEnumDescriptions": [
            "Use the editor's Language Model API, reusing whatever subscription you are already signed in to in VS Code. No API key needed.",
            "Call the Anthropic API directly with a key stored in VS Code's secret storage."
          ],
          "description": "Where model calls go."
        },
        "donna.llm.vscodeModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "Preferred model `family` from the editor's Language Model API (for example `claude-sonnet-4.5`, `gpt-4o`). Empty picks the first available."
        },
        "donna.llm.anthropicModel": {
          "type": "string",
          "default": "claude-sonnet-4-5",
          "description": "Model ID used when the provider is \"anthropic\"."
        },
        "donna.llm.maxFilesPerReview": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "description": "Cap on how many changed files are sent to the model in one pass."
        },
        "donna.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Also publish findings as squiggles in the Problems pane."
        },
        "donna.diagnostics.floor": {
          "type": "string",
          "enum": [
            "conflict",
            "unknown",
            "attention"
          ],
          "default": "unknown",
          "description": "Least severe status that gets a squiggle. Everything still appears in the Donna views."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:offline": "tsc --noEmit -p tsconfig.devcheck.json",
    "pretest": "tsc -p tsconfig.eval.json",
    "test": "node out-eval/test/run-unit.js && node out-eval/test/run-eval.js",
    "test:unit": "npm run pretest && node out-eval/test/run-unit.js",
    "eval": "npm run pretest && node out-eval/test/run-eval.js",
    "package": "npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1"
  }
}
